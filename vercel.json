{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/index.php?action=ping" },
    { "source": "/api/download", "destination": "/api/index.php?action=download" },
    { "source": "/api/upload", "destination": "/api/index.php?action=upload" }
  ]
}
